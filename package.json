{
    "name": "layout-lens",
    "displayName": "Layout Lens for CSS",
    "description": "Highlight Flexbox and Grid properties in your CSS, SCSS, and LESS files.",
    "author": {
        "email": "th3fishMk@proton.me",
        "name": "th3fishMk",
        "url": "https://github.com/th3fishMk"
    },
    "publisher": "th3pool",
    "repository": {
        "type": "git",
        "url": "https://github.com/th3pool/layout-lens"
    },
    "icon": "./media/icon.png",
    "license": "MIT",
    "readme": "README.md",
    "preview": true,
    "version": "0.1.1",
    "engines": {
        "vscode": "^1.118.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:css",
        "onLanguage:scss",
        "onLanguage:less"
    ],
    "keywords": [
        "css",
        "flexbox",
        "grid",
        "layout",
        "web",
        "frontend"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "type": "object",
            "title": "Layout Lens",
            "properties": {
                "layout-lens.enableFlexbox": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Flexbox highlighting"
                },
                "layout-lens.enableGrid": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Grid highlighting"
                },
                "layout-lens.enableCommon": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Enable highlighting of properties common to both Flexbox and Grid containers, e.g. `display`, `align-items`, etc."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "~22.19.18",
        "@types/vscode": "^1.118.0",
        "@typescript-eslint/eslint-plugin": "^8.59.2",
        "@typescript-eslint/parser": "^8.59.2",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.39.4",
        "ts-loader": "^9.5.7",
        "typescript": "^5.9.3",
        "webpack": "^5.106.2",
        "webpack-cli": "^6.0.1"
    }
}
